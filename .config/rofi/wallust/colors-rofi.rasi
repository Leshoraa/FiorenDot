 /* wallust template - colors-rofi */

* {
active-background: #5197AE;
active-foreground: #E9EDEF;
normal-background: #0A1016;
normal-foreground: #E9EDEF;
urgent-background: #7D93C0;
urgent-foreground: #E9EDEF;

alternate-active-background: #DFBB68;
alternate-active-foreground: #E9EDEF;
alternate-normal-background: #0A1016;
alternate-normal-foreground: #E9EDEF;
alternate-urgent-background: #0A1016;
alternate-urgent-foreground: #E9EDEF;

selected-active-background: #5197AE;
selected-active-foreground: #E9EDEF;
selected-normal-background: #5197AE;
selected-normal-foreground: #E9EDEF;
selected-urgent-background: #5197AE;
selected-urgent-foreground: #E9EDEF;

background-color: #0A1016;
background: rgba(0,0,0,0.7);
foreground: #E9EDEF;
border-color: #5197AE;

color0: #0A1016;
color1: #CA5249;
color2: #2F4C56;
color3: #CDA751;
color4: #447F92;
color5: #6E84B0;
color6: #6FA6B9;
color7: #E9EDEF;
color8: #3B5268;
color9: #DD685F;
color10: #3C6876;
