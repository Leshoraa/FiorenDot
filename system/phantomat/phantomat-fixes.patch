+void CScrollOverview::renderWorkspaceFadeouts(PHLMONITOR monitor, size_t workspaceIdx, size_t activeIdx, float workspacePitch, float renderScale) {
+    if (!monitor || workspaceIdx >= images.size() || !images[workspaceIdx] || !images[workspaceIdx]->pWorkspace)
+        return;
+
+    const auto WORKSPACE = images[workspaceIdx]->pWorkspace;
+    const auto WORKSPACEOFFSET = workspaceOverviewOffset(workspaceIdx, activeIdx, workspacePitch);
+
+    for (const auto& fadeout : Desktop::fadingOutState()->fadeouts()) {
+        if (!fadeout || fadeout->done())
+            continue;
+
+        const auto PLANE = fadeout->plane();
+        if (PLANE != Desktop::FADEOUT_PLANE_WINDOW_TILED &&
+            PLANE != Desktop::FADEOUT_PLANE_WINDOW_FLOATING &&
+            PLANE != Desktop::FADEOUT_PLANE_WINDOW_OVER_FULLSCREEN)
+            continue;
+
+        if (fadeout->workspace().lock() != WORKSPACE)
+            continue;
+
+        const auto FB = fadeout->framebuffer();
+        if (!FB)
+            continue;
+
+        const auto TEX = FB->getTexture();
+        if (!TEX)
+            continue;
+
+        const float ALPHA = std::clamp(fadeout->alpha(), 0.F, 1.F);
+        const float TARGET_ALPHA = ALPHA * overviewProgress();
+        if (TARGET_ALPHA <= 0.001F)
+            continue;
+
+        const auto FADEOUTBOX = getOverviewGlobalBox(fadeout->renderBox(), monitor, renderScale, viewOffset->value(), WORKSPACEOFFSET, layout, false);
+        if (!overviewBoxIntersectsMonitor(FADEOUTBOX, monitor))
+            continue;
+
+        const auto EFFECTS = fadeout->effects();
+        int rounding = 0;
+        float roundingPower = 2.F;
+        if (EFFECTS.preBlur && EFFECTS.preBlur->round > 0) {
+            rounding = sc<int>(std::round(EFFECTS.preBlur->round * renderScale));
+            roundingPower = EFFECTS.preBlur->roundingPower;
+        } else {
+            rounding = sc<int>(std::round(ScrollOverview::Config::getValue<int>("decoration:rounding") * monitor->m_scale * renderScale));
+        }
+
+        CTexPassElement::SRenderData data;
+        data.tex = TEX;
+        data.box = FADEOUTBOX.copy().round();
+        data.a = TARGET_ALPHA;
+        data.round = rounding;
+        data.roundingPower = roundingPower;
+        data.flipEndFrame = true;
+        g_pHyprRenderer->m_renderPass.add(makeUnique<CTexPassElement>(data));
+        OverviewRender::flushPass(monitor);
+    }
+}
