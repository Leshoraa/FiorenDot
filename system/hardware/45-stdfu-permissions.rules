# DFU (Bootloader STM32 & AT32)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0664", GROUP="uucp"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="df11", MODE="0664", GROUP="uucp"

# Virtual COM Port (Flight Controller Serial)
KERNEL=="ttyACM*", MODE="0666", GROUP="uucp"
KERNEL=="ttyUSB*", MODE="0666", GROUP="uucp"
