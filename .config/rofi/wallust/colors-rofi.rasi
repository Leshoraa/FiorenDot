 /* wallust template - colors-rofi */

* {
active-background: #CE507E;
active-foreground: #EFE9EB;
normal-background: #1C0D12;
normal-foreground: #EFE9EB;
urgent-background: #CD7073;
urgent-foreground: #EFE9EB;

alternate-active-background: #DFBB68;
alternate-active-foreground: #EFE9EB;
alternate-normal-background: #1C0D12;
alternate-normal-foreground: #EFE9EB;
alternate-urgent-background: #1C0D12;
alternate-urgent-foreground: #EFE9EB;

selected-active-background: #CD7073;
selected-active-foreground: #EFE9EB;
selected-normal-background: #CD7073;
selected-normal-foreground: #EFE9EB;
selected-urgent-background: #CE507E;
selected-urgent-foreground: #EFE9EB;

background-color: #1C0D12;
background: rgba(0,0,0,0.7);
foreground: #EFE9EB;
border-color: #CE507E;

color0: #1C0D12;
color1: #CA4978;
color2: #762D48;
color3: #CDA751;
color4: #BF3668;
color5: #BD6164;
color6: #D47296;
