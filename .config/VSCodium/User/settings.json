    "editor.tokenColorCustomizations": {
        "comments": "#8AC3E4",
        "textMateRules": [
            {
                "scope": [
                    "keyword.operator",
                    "keyword.other.directive.using.cs",
                    "storage",
                    "constant.language",
                    "punctuation",
                    "punctuation.separator",
                    "punctuation.terminator",
                    "punctuation.terminator.statement.cs",
                    "punctuation.parenthesis.open.cs",
                    "punctuation.parenthesis.close.cs",
                    "punctuation.curlybrace.open.cs",
                    "punctuation.curlybrace.close.cs"
                ],
                "settings": {
                    "foreground": "#E6EAEC"
                }
            },
            {
                "scope": [
                    "variable.language",
                    "variable.language.base.cs",
                    "variable.language.this.cs"
                ],
                "settings": {
                    "foreground": "#6DAFC9"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted",
                    "string.quoted.double",
                    "string.quoted.single",
                    "string.template",
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#6DAFC9"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.namespace",
                    "support.class",
                    "support.type",
                    "entity.name.variable",
                    "constant.character.escape",
                    "keyword.operator.expression",
                    "constant.numeric.decimal.cs",
                    "entity.other.attribute-name.html",
                    "keyword.operator.new.js",
                    "punctuation.definition.template-expression.begin.js",
                    "string.template.js",
                    "punctuation.definition.template-expression.end.js"
                ],
                "settings": {
                    "foreground": "#6DAFC9"
                }
            }
        ]
    },
    "files.autoSave": "afterDelay",
    "workbench.iconTheme": "minimal-icons-without-explorer-arrows",
    "editor.cursorSmoothCaretAnimation": "on",
    "chat.experimental.incrementalRendering.animationStyle": "blur",
    "editor.smoothScrolling": true,
    "editor.cursorBlinking": "expand",
    "terminal.integrated.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "workbench.iconTheme": "material-icon-theme"
}