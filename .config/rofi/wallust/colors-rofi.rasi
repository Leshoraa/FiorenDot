 /* wallust template - colors-rofi */

* {
active-background: #5E7AA1;
active-foreground: #EBECED;
normal-background: #0D1015;
normal-foreground: #EBECED;
urgent-background: #BD7F80;
urgent-foreground: #EBECED;

alternate-active-background: #DFBB68;
alternate-active-foreground: #EBECED;
alternate-normal-background: #0D1015;
alternate-normal-foreground: #EBECED;
alternate-urgent-background: #0D1015;
alternate-urgent-foreground: #EBECED;

selected-active-background: #BD7F80;
selected-active-foreground: #EBECED;
selected-normal-background: #BD7F80;
selected-normal-foreground: #EBECED;
selected-urgent-background: #5E7AA1;
selected-urgent-foreground: #EBECED;

background-color: #0D1015;
background: rgba(0,0,0,0.7);
foreground: #EBECED;
border-color: #5E7AA1;

color0: #0D1015;
color1: #CA494B;
color2: #354050;
color3: #CDA751;
color4: #4F6687;
color5: #AD7071;
color6: #798FAE;
color7: #EBECED;
color8: #424F61;
color9: #DD5F61;
color10: #44566E;
color11: #DFBB68;
color12: #5E7AA1;
color13: #BD7F80;
color14: #8CA1BF;
color15: #EBECED;


}

