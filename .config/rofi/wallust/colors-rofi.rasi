 /* wallust template - colors-rofi */

* {
active-background: #7A7FB8;
active-foreground: #EBEBED;
normal-background: #121219;
normal-foreground: #EBEBED;
urgent-background: #9A89BD;
urgent-foreground: #EBEBED;

alternate-active-background: #DFBB68;
alternate-active-foreground: #EBEBED;
alternate-normal-background: #121219;
alternate-normal-foreground: #EBEBED;
alternate-urgent-background: #121219;
alternate-urgent-foreground: #EBEBED;

selected-active-background: #7A7FB8;
selected-active-foreground: #EBEBED;
selected-normal-background: #7A7FB8;
selected-normal-foreground: #EBEBED;
selected-urgent-background: #7A7FB8;
selected-urgent-foreground: #EBEBED;

background-color: #121219;
background: rgba(0,0,0,0.7);
foreground: #EBEBED;
border-color: #7A7FB8;

color0: #121219;
color1: #CA5249;
color2: #363959;
color3: #CDA751;
color4: #565C9F;
color5: #8674AA;
color6: #9094C1;
color7: #EBEBED;
color8: #45455F;
color9: #DD685F;
color10: #474B7B;
