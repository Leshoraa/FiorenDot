* {
    background:     #151310;
    foreground:     #e7e2db;

    color0:     #0f0e0b;
    color1:     #d5c68f;
    color2:     #cfc6ac;
    color3:     #b6cea3;
    color4:     #9d915e;
    color5:     #4c4732;
    color6:     #819771;
    color7:     #ccc6b7;
    color8:     #969082;
    color9:     #d5c68f;
    color10:     #cfc6ac;
    color11:     #b6cea3;
    color12:     #9d915e;
    color13:     #4c4732;
    color14:     #819771;
    color15:     #e7e2db;

    background-color:   @background;
    border-color:       @color8;
    spacing:            2;
}
