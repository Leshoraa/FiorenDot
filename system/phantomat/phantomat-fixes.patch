+void CScrollOverview::cycleOverviewWindow(int delta) {
+    const auto MONITOR = pMonitor.lock();
+    if (!MONITOR)
+        return;
+
+    std::vector<PHLWINDOW> allWindows;
+    for (const auto& wRef : Desktop::windowState()->windows()) {
+        const auto W = getOverviewWindowToShow(wRef);
+        if (!shouldShowOverviewWindow(W) || W->m_pinned)
+            continue;
+        if (W->m_monitor != pMonitor)
+            continue;
+        if (std::find(allWindows.begin(), allWindows.end(), W) == allWindows.end())
+            allWindows.push_back(W);
+    }
+
+    if (allWindows.empty())
+        return;
+
+    const auto ACTIVEIDX = activeWorkspaceIndex();
+    const auto PITCH     = getWorkspaceRenderedPitch(MONITOR, scale->value(), layout);
+
+    const auto getWindowWsIdx = [this](const PHLWINDOW& w) -> size_t {
+        for (size_t i = 0; i < images.size(); ++i) {
+            if (images[i] && images[i]->pWorkspace == w->m_workspace)
+                return i;
+        }
+        return 0;
+    };
+
+    const auto getWindowScreenCenter = [&](const PHLWINDOW& w) -> Vector2D {
+        const size_t wsIdx    = getWindowWsIdx(w);
+        const auto   wsOffset = workspaceOverviewOffset(wsIdx, ACTIVEIDX, PITCH);
+        const auto   box      = getOverviewWindowBox(w, MONITOR, scale->value(), viewOffset->value(), wsOffset, layout);
+        return box.middle();
+    };
+
+    // Sort windows in visual workspace & geometric order
+    std::sort(allWindows.begin(), allWindows.end(), [&](const PHLWINDOW& a, const PHLWINDOW& b) {
+        const size_t wsA = getWindowWsIdx(a);
+        const size_t wsB = getWindowWsIdx(b);
+        if (wsA != wsB)
+            return wsA < wsB;
+        const auto boxA = a->geometricBox(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+        const auto boxB = b->geometricBox(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+        if (std::abs(boxA.y - boxB.y) > 30.0)
+            return boxA.y < boxB.y;
+        return boxA.x < boxB.x;
+    });
+
+    const auto viewportBox = CBox{{}, MONITOR->m_size * MONITOR->m_scale};
+    const auto vpCenter    = viewportBox.middle();
+
+    auto CURRENT = getOverviewWindowToShow(closeOnWindow.lock());
+    if (!shouldShowOverviewWindow(CURRENT))
+        CURRENT = getOverviewWindowToShow(Desktop::focusState()->window());
+
+    int curIndex = -1;
+    bool currentOnScreen = false;
+    if (CURRENT) {
+        const auto center = getWindowScreenCenter(CURRENT);
+        if (center.x >= -50.0 && center.x <= viewportBox.width + 50.0 &&
+            center.y >= -50.0 && center.y <= viewportBox.height + 50.0) {
+            currentOnScreen = true;
+        }
+    }
+
+    if (currentOnScreen && CURRENT) {
+        for (size_t i = 0; i < allWindows.size(); ++i) {
+            if (allWindows[i] == CURRENT) {
+                curIndex = sc<int>(i);
+                break;
+            }
+        }
+    }
+
+    // If CURRENT is off-screen (camera was panned away), anchor to window closest to current camera center
+    if (curIndex < 0) {
+        double minCenterDist = std::numeric_limits<double>::max();
+        for (size_t i = 0; i < allWindows.size(); ++i) {
+            const auto center = getWindowScreenCenter(allWindows[i]);
+            const auto d      = center - vpCenter;
+            const double dist = d.x * d.x + d.y * d.y;
+            if (dist < minCenterDist) {
+                minCenterDist = dist;
+                curIndex      = sc<int>(i);
+            }
+        }
+    }
+
+    if (curIndex < 0)
+        curIndex = 0;
+
+    const int count     = sc<int>(allWindows.size());
+    int       nextIndex = (curIndex + delta) % count;
+    if (nextIndex < 0)
+        nextIndex += count;
+
+    const auto targetWindow = allWindows[nextIndex];
+    if (!targetWindow)
+        return;
+
+    closeOnWindow = targetWindow;
+    rememberSelection(targetWindow);
+
+    const size_t targetWsIdx = getWindowWsIdx(targetWindow);
+    viewportCurrentWorkspace = targetWsIdx;
+
+    // Center camera smoothly on target window from current view
+    const auto     WINBOX       = targetWindow->geometricBox(Desktop::View::IGeometric::GEOMETRIC_CURRENT);
+    const auto     WIN_MID      = WINBOX.middle();
+    const auto     MON_MID      = MONITOR->m_position + MONITOR->m_size * 0.5F;
+    const auto     WS_OFFSET    = workspaceOverviewOffset(targetWsIdx, ACTIVEIDX, PITCH);
+    const float    RENDERSCALE  = std::max(scale->value(), 0.01F);
+    const float    MONITORSCALE = std::max(MONITOR->m_scale, 0.01F);
+
+    const Vector2D targetOffset = (WIN_MID - MON_MID) + WS_OFFSET / (RENDERSCALE * MONITORSCALE);
+    *viewOffset                 = targetOffset;
+
+    markBlurDirty();
+    damage();
+}
