 /* wallust template - colors-rofi */

* {
active-background: #6C7AC6;
active-foreground: #EAEAEE;
normal-background: #0D0F1C;
normal-foreground: #EAEAEE;
urgent-background: #917DC9;
urgent-foreground: #EAEAEE;

alternate-active-background: #DFBB68;
alternate-active-foreground: #EAEAEE;
alternate-normal-background: #0D0F1C;
alternate-normal-foreground: #EAEAEE;
alternate-urgent-background: #0D0F1C;
alternate-urgent-foreground: #EAEAEE;

selected-active-background: #6C7AC6;
selected-active-foreground: #EAEAEE;
selected-normal-background: #6C7AC6;
selected-normal-foreground: #EAEAEE;
selected-urgent-background: #6C7AC6;
selected-urgent-foreground: #EAEAEE;

background-color: #0D0F1C;
background: rgba(0,0,0,0.7);
foreground: #EAEAEE;
border-color: #6C7AC6;

color0: #0D0F1C;
color1: #CA5249;
color2: #2E3660;
color3: #CDA751;
color4: #4555B0;
color5: #7C67B6;
color6: #848FCC;
