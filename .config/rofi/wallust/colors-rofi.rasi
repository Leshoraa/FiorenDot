 /* wallust template - colors-rofi */

* {
active-background: #6DAFC9;
active-foreground: #09161B;
normal-background: #09161B;
normal-foreground: #E6EAEC;
urgent-background: #8AC3E4;
urgent-foreground: #09161B;

alternate-active-background: #99C5DE;
alternate-active-foreground: #09161B;
alternate-normal-background: #09161B;
