/* =======================================================
 *   FiorenDot — Project Switcher Interface
 *   Author: Fioren (@Leshoraa)
 *   Device: ASUS Vivobook S 14 Flip
 *   Style: Modern Glass / Touch-Friendly
 * ======================================================= */

configuration {
    modi:                       "dmenu";
    show-icons:                 false;
    hover-select:               true;
    click-to-exit:              true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
}

@theme "~/.config/rofi/wallust/colors-rofi.rasi"

* {
    font:                       "JetBrainsMono Nerd Font 11";
    selected:                   @color12;
    active:                     @color11;
    urgent:                     @color13;
    text-selected:              @background;
    text-color:                 @foreground;
    border-color:               @selected;
}

window {
    enabled:                    true;
    fullscreen:                 false;
    transparency:               "real";
    cursor:                     "default";
    spacing:                    0px;
    border:                     2px;
    border-radius:              18px;
    border-color:               @selected;
    location:                   center;
    anchor:                     center;
    width:                      640px;
    background-color:           rgba(15, 15, 23, 0.85);
}

mainbox {
    enabled:                    true;
    orientation:                vertical;
    spacing:                    14px;
    padding:                    20px;
    background-color:           transparent;
    children:                   [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    padding:                    12px 16px;
    border:                     1.5px;
    border-radius:              12px;
    border-color:               @selected;
    background-color:           rgba(15, 15, 23, 0.6);
    children:                   [ "entry" ];
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     text;
    placeholder:                " 󰘐  Pilih Project (~/Projects)...";
    placeholder-color:          rgba(255, 255, 255, 0.4);
    vertical-align:             0.5;
}

message {
    enabled:                    true;
    background-color:           transparent;
    border:                     0px;
}

textbox {
    padding:                    8px 12px;
    border-radius:              10px;
    background-color:           rgba(255, 255, 255, 0.05);
    text-color:                 @color11;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      7;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    8px;
    padding:                    2px 0px;
    background-color:           transparent;
    border:                     0px;
}

element {
    enabled:                    true;
    spacing:                    14px;
    padding:                    10px 16px;
    border-radius:              10px;
    background-color:           transparent;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @foreground;
}

element selected.normal {
    background-color:           @selected;
    text-color:                 @background;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

element-text selected {
    background-color:           transparent;
    text-color:                 @background;
}
