#!/usr/bin/env bash
# Wallust-to-Matugen bridge wrapper
# Intercepts legacy wallust calls and executes matugen instead

if [[ "$1" == "run" ]]; then
    shift
    img=""
    for arg in "$@"; do
        if [[ ! "$arg" =~ ^- && -f "$arg" ]]; then
            img="$arg"
        fi
    done
    if [[ -n "$img" && -f "$img" ]]; then
        exec matugen image "$img" --type scheme-content --mode dark --prefer saturation
    fi
fi

if [[ -x /usr/bin/wallust ]]; then
    exec /usr/bin/wallust "$@"
fi
