[Unit]
Description=AMD P-State Smart Frequency Scaling (balance_power)
After=power-profiles-daemon.service sleep.target suspend.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo balance_power > "$f"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target sleep.target
