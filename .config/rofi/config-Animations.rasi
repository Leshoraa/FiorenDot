/* Animations Menu */

@import "~/.config/rofi/config.rasi" 

/* ---- Entry ---- */ 
entry {
  placeholder: " 󰸌  Search / Choose which Animations to load";
}

/* ---- Listview ---- */
listview {
  columns: 1;
  lines: 6;
  margin: 0px;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element-icon {
  size: 0%;
}
element-text {
  horizontal-align: 0.0;
  vertical-align: 0.0;
  margin: 0px;
  padding: 0px;
}
