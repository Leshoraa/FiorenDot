alternate-urgent-background: #09161B;
alternate-urgent-foreground: #E6EAEC;

selected-active-background: #6DAFC9;
selected-active-foreground: #09161B;
selected-normal-background: #6DAFC9;
selected-normal-foreground: #09161B;
selected-urgent-background: #6DAFC9;
selected-urgent-foreground: #09161B;

background-color: #09161B;
background: rgba(0,0,0,0.7);
foreground: #E6EAEC;
border-color: #6DAFC9;

color0: #09161B;
