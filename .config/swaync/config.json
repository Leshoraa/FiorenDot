{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "left",
  "positionY": "bottom",
  "control-center-positionX": "right",
  "control-center-positionY": "bottom",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-window-width": 360,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 420,
  "control-center-height": 740,
  "keyboard-shortcuts": true,
  "image-visibility": "never",
  "notification-grouping": false,
  "transition-time": 500,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "menubar#power",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "notifications"
  ],
  "widget-config": {
    "menubar#power": {
      "buttons#title": {
        "position": "left",
        "actions": [
          {
            "label": "⊹ ࣪ ﹏𓊝﹏𓂁﹏﹏⊹ ࣪ ˖",
            "command": "hyprctl dispatch dpms off"
          }
        ]
      },
      "menu#power": {
        "label": "",
        "position": "right",
        "actions": [
          {
            "label": "󰑐 Reboot",
            "command": "systemctl reboot"
          },
          {
            "label": "󰤆 Shutdown",
            "command": "systemctl poweroff"
          }
        ]
      }
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰈊  Color Picker",
          "command": "hyprpicker -a"
        },
        {
          "label": "  Screenshot",
          "command": "$HOME/.config/hypr/scripts/ScreenShot.sh --now"
        },
        {
          "label": "󰤄  Do Not Disturb",
          "command": "swaync-client -d -sw",
          "type": "toggle",
          "update-command": "swaync-client -D"
        },
        {
          "label": "󱐋  Battery Limit",
          "type": "toggle",
          "command": "$HOME/.config/hypr/scripts/BatteryLimitToggle.sh toggle",
          "update-command": "$HOME/.config/hypr/scripts/BatteryLimitToggle.sh status"
        },
        {
          "label": "󰝟  Mute Audio",
          "type": "toggle",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
        },
        {
          "label": "󰂯  Bluetooth",
          "command": "blueman-manager"
        }
      ]
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": ""
    },
    "mpris": {
      "autohide": true
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": false,
      "show-per-app-label": true,
      "expand-per-app": false,
      "expand-button-label": "󰅁",
      "collapse-button-label": "󰅀"
    },
    "backlight": {
      "label": "󰃟",
      "device": "amdgpu_bl1"
    },
    "notifications": {
      "vexpand": true
    }
  }
}