 /* wallust template - colors-rofi */

* {
active-background: #8092C6;
active-foreground: #EBEBED;
normal-background: #141517;
normal-foreground: #EBEBED;
urgent-background: #9786CB;
urgent-foreground: #EBEBED;

alternate-active-background: #EBC670;
alternate-active-foreground: #EBEBED;
alternate-normal-background: #141517;
alternate-normal-foreground: #EBEBED;
alternate-urgent-background: #141517;
alternate-urgent-foreground: #EBEBED;

selected-active-background: #9786CB;
selected-active-foreground: #EBEBED;
selected-normal-background: #9786CB;
selected-normal-foreground: #EBEBED;
selected-urgent-background: #8092C6;
selected-urgent-foreground: #EBEBED;

background-color: #141517;
background: rgba(0,0,0,0.7);
foreground: #EBEBED;
border-color: #8092C6;

color0: #141517;
color1: #D2544B;
color2: #4F5D88;
color3: #DAB04E;
color4: #6479B9;
color5: #8473B4;
color6: #9FABD0;
color7: #EBEBED;
color8: #565961;
color9: #E5746C;
color10: #5367A2;
