 /* wallust template - colors-rofi */

* {
active-background: #C15533;
active-foreground: #EDEBEA;
normal-background: #1B110D;
normal-foreground: #EDEBEA;
urgent-background: #CDA470;
urgent-foreground: #EDEBEA;

alternate-active-background: #DFBB68;
alternate-active-foreground: #EDEBEA;
alternate-normal-background: #1B110D;
alternate-normal-foreground: #EDEBEA;
alternate-urgent-background: #1B110D;
alternate-urgent-foreground: #EDEBEA;

selected-active-background: #C15533;
selected-active-foreground: #EDEBEA;
selected-normal-background: #C15533;
selected-normal-foreground: #EDEBEA;
selected-urgent-background: #C15533;
selected-urgent-foreground: #EDEBEA;

background-color: #1B110D;
background: rgba(0,0,0,0.7);
foreground: #EDEBEA;
border-color: #C15533;

color0: #1B110D;
color1: #CA6749;
color2: #5A2E21;
color3: #CDA751;
color4: #A1462B;
color5: #BD9561;
color6: #CA6749;
color7: #EDEBEA;
color8: #68463B;
color9: #DD7D5F;
color10: #7C3B27;
color11: #DFBB68;
