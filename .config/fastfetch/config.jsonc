{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/berserk.txt",
        "padding": {
            "top": 1,
            "right": 6
        },
        "color": {
            "1": "bright_cyan" 
        }
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        {
            "type": "custom",
            "format": " \u001b[38;5;14m : I am ...\u001b[0m"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐"
        },
        {
            "type": "os",
            "key": "  󰣇 OS",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "  󰒋 Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "  󰏖 Packages",
            "keyColor": "cyan"
        },
        {
            "type": "display",
            "key": "  󰹑 Display",
            "format": "{1}x{2}, {3} Hz",
            "keyColor": "cyan"
        },
        {
            "type": "terminal",
            "key": "  󰆍 Terminal",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "  󱂬 WM",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "title",
            "key": "  \u001b[38;5;13m\u001b[0m",
            "format": "\u001b[38;5;13m{1} @ {2}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────────┐"
        },
        {
            "type": "cpu",
            "key": "  󰻠 CPU",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "key": "  󰢮 GPU",
            "keyColor": "cyan",
            "format": "Radeon Vega Series"
        },
        {
            "type": "memory",
            "key": "  󰍛 Memory",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "  󰔟 Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "  \u001b[38;5;14m● \u001b[38;5;10m● \u001b[38;5;12m● \u001b[38;5;13m● \u001b[38;5;6m● \u001b[38;5;2m● \u001b[38;5;4m● \u001b[38;5;7m●\u001b[0m"
        }
    ]
}