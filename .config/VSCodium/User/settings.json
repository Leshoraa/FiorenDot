        "tab.activeUnfocusedForeground": "#6DAFC9",
        "breadcrumb.foreground": "#6DAFC9",
        "breadcrumb.focusForeground": "#E6EAEC",
        "textLink.foreground": "#E6EAEC",
        "textLink.activeForeground": "#6DAFC9",
        "button.background": "#6DAFC9",
