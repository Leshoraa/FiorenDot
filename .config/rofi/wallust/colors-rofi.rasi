 /* wallust template - colors-rofi */

* {
active-background: #7A7BB8;
active-foreground: #EBEBED;
normal-background: #131219;
normal-foreground: #EBEBED;
urgent-background: #9E89BD;
urgent-foreground: #EBEBED;

alternate-active-background: #DFBB68;
alternate-active-foreground: #EBEBED;
alternate-normal-background: #131219;
alternate-normal-foreground: #EBEBED;
alternate-urgent-background: #131219;
alternate-urgent-foreground: #EBEBED;

selected-active-background: #7A7BB8;
selected-active-foreground: #EBEBED;
selected-normal-background: #7A7BB8;
selected-normal-foreground: #EBEBED;
selected-urgent-background: #7A7BB8;
selected-urgent-foreground: #EBEBED;

background-color: #131219;
background: rgba(0,0,0,0.7);
foreground: #EBEBED;
border-color: #7A7BB8;

color0: #131219;
color1: #CA5249;
color2: #363759;
color3: #CDA751;
color4: #56579F;
color5: #8974AA;
color6: #9090C1;
color7: #EBEBED;
color8: #46455F;
color9: #DD685F;
color10: #47487B;
