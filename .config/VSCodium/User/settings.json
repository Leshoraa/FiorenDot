        "titleBar.inactiveForeground": "#070E11",
        "tab.activeBorderTop": "#6DAFC9",
        "editorGutter.background": "#070E11",
        "editor.background": "#070E11",
        "editor.foreground": "#E6EAEC",
        "sideBar.background": "#070E11",
        "sideBar.foreground": "#6DAFC9",
        "list.activeSelectionForeground": "#6DAFC9",
        "list.inactiveSelectionForeground": "#6DAFC9",
        "list.focusForeground": "#6DAFC9",
        "list.hoverForeground": "#6DAFC9",
        "activityBar.background": "#070E11",
        "activityBar.foreground": "#6DAFC9",
        "statusBar.background": "#070E11",
        "statusBar.foreground": "#E6EAEC",
        "terminal.ansiBlack": "#09161B",
        "terminal.ansiRed": "#E7AE8D",
        "terminal.ansiGreen": "#F2BDA7",
        "terminal.ansiYellow": "#84ABC1",
        "terminal.ansiBlue": "#6DAFC9",
        "terminal.ansiMagenta": "#8DA9BF",
        "terminal.ansiCyan": "#E7AE8D",
        "terminal.ansiWhite": "#E6EAEC",
